# Configuration base de données PostgreSQL (Cloud SQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bibliotheque
DB_USER=postgres
DB_PASSWORD=1234

# En production Google Cloud Run, utilise le socket Unix :
# DB_HOST=/cloudsql/TON_PROJECT_ID:REGION:NOM_INSTANCE

# Port du serveur
PORT=5000

# Environnement
NODE_ENV=development


